NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key-for-embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CONTEXT_ENGINE_ACCESS_KEY=replace-with-a-random-32-character-or-longer-secret
# strict withholds an answer unless every citation is verified; lenient shows it with a warning when at least one is
CITATION_POLICY=strict
